<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Opportunità di Tirocinio</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      padding: 20px;
    }

    h1 {
      text-align: center;
    }

    .filter-container {
      margin: 20px 0;
      text-align: center;
    }

    .filter-container select {
      padding: 10px;
      font-size: 16px;
    }

    .table-container {
      width: 100%;
      border-collapse: collapse;
      display: table;
    }

    .table-header, .content-row {
      display: table-row;
    }

    .table-header div, .content-cell {
      display: table-cell;
      vertical-align: top;
      padding: 12px;
      border: 1px solid #ccc;
    }

    .table-header {
      background-color: #f0f0f0;
      font-weight: bold;
      text-align: center;
    }

    .logo img {
      width: 100px;
      height: auto;
    }

    .text-box h2 {
      margin: 0;
    }

    .text-box p {
      margin: 5px 0 0 0;
    }

    .content-row[data-first="true"] .content-cell {
      border-top: 3px solid #999;
    }

    .content-row.hidden {
      display: none;
    }
  </style>
</head>
<body>

  <h1>Elenco delle Opportunità di Tirocinio</h1>

  <!-- Filtro per area didattica -->
  <div class="filter-container">
    <label for="area-filter">Filtra per Area Didattica:</label>
    <select id="area-filter">
      <option value="all">Tutte le aree</option>
      <option value="CODIMEG">CODIMEG</option>
      <option value="CODIC">CODIC</option>
      <option value="CODELE">CODELE</option>
    </select>
  </div>

  <!-- Tabella a 5 colonne -->
  <div class="table-container">
    <!-- Intestazioni -->
    <div class="table-header">
      <div></div>
      <div>Azienda</div>
      <div>Opportunità</div>
      <div>Tutor accademico</div>
      <div>Codice</div>
    </div>

    <!-- ARES: una sola opportunità -->
    <div class="content-row" data-areas="CODIMEG" data-first="true">
      <div class="content-cell logo" rowspan="1">
        <a href="xxx1" target="_blank">
          <img src="logo_ares.png" alt="ARES s.r.l.">
        </a>
      </div>
      <div class="content-cell text-box">
        <h2><a href="yyy1" target="_blank">ARES s.r.l.</a></h2>
        <p>Start-up innovativa nel settore energetico</p>
      </div>
      <div class="content-cell opportunity-box">
        Progettazione e realizzazione di componenti per il settore energetico
      </div>
      <div class="content-cell">Prof. Maiorino</div>
      <div class="content-cell">ARES001XYZ</div>
    </div>

    <!-- ENEA: due opportunità, due righe diverse -->
    <div class="content-row" data-areas="CODELE" data-first="true">
      <div class="content-cell logo" rowspan="2">
        <a href="xxx2" target="_blank">
          <img src="logo_enea.png" alt="ENEA">
        </a>
      </div>
      <div class="content-cell text-box">
        <h2><a href="yyy2" target="_blank">ENEA</a></h2>
        <p>Agenzia nazionale per le nuove tecnologie, l’energia e lo sviluppo economico sostenibile</p>
      </div>
      <div class="content-cell opportunity-box">
        Progettazione di smart grid
      </div>
      <div class="content-cell">Prof. Liguori</div>
      <div class="content-cell">ENEA_SMRT001</div>
    </div>

    <div class="content-row" data-areas="CODIC">
      <div class="content-cell logo"></div>
      <div class="content-cell text-box"></div>
      <div class="content-cell opportunity-box">
        Sviluppo di materiali per energie rinnovabili
      </div>
      <div class="content-cell">Prof. Rossi</div>
      <div class="content-cell">ENEA_MATR002</div>
    </div>
  </div>

  <script>
    // Filtro per area didattica
    document.getElementById('area-filter').addEventListener('change', function () {
      const selectedArea = this.value;
      const rows = document.querySelectorAll('.content-row');

      rows.forEach(row => {
        const areas = row.getAttribute('data-areas')?.split(',');
        if (selectedArea === 'all' || areas?.includes(selectedArea)) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });
    });
  </script>

</body>
</html>
